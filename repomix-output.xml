  .hero{ padding:44px 0 56px; }
  .doc-card{ flex-direction:column; align-items:flex-start; }
  .doc-card .doc-actions{ width:100%; justify-content:space-between; }
  .modal-box{ padding:24px 20px; }
  .verify-code-form{ flex-wrap:wrap; }
  .verify-code-form input{ min-width:0; flex:1 1 100%; }
}
