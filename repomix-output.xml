.hero .wrap{ display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:center; }
.hero-eyebrow{
  font-family:var(--f-mono); font-size:0.7rem; letter-spacing:0.16em; text-transform:uppercase;
  color:var(--amber); margin:0 0 18px;
}
.hero h1{
  font-family:var(--f-display); font-weight:600; font-size:clamp(2.3rem, 4vw, 3.4rem);
  line-height:1.05; margin:0 0 20px; letter-spacing:-0.01em;
}
.hero h1 em{ font-style:italic; color:var(--amber); font-weight:500; }
.hero p.lede{
  font-size:1.08rem; line-height:1.6; color:rgba(246,241,227,0.78); max-width:46ch; margin:0 0 30px;
}
.hero-actions{ display:flex; gap:14px; flex-wrap:wrap; }

/* Faint food/drink line-icon scatter — grounds the abstract dial in
   "this is a food site" visually, not just through color and copy. */
.hero-motif{ position:absolute; inset:0; pointer-events:none; color:rgba(246,241,227,0.09); }
.motif-icon{ position:absolute; width:64px; height:64px; }
.motif-cup{ top:10%; right:8%; width:56px; transform:rotate(-6deg); }
.motif-bread{ bottom:8%; right:28%; width:80px; transform:rotate(4deg); }
.motif-plate{ top:58%; right:2%; width:70px; transform:rotate(-3deg); }
.motif-pot{ top:6%; left:42%; width:50px; transform:rotate(8deg); }
@media (max-width: 860px){ .motif-plate, .motif-pot{ display:none; } }

.dial-card{
  background:rgba(246,241,227,0.05);
  border:1px solid var(--line-light);
  border-radius:16px;
  padding:26px;
  backdrop-filter:blur(6px);
  position:relative;
}
.dial-card .dial-label{
  font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase;
  color:rgba(246,241,227,0.55); display:flex; justify-content:space-between; margin-bottom:14px;
}

/* Steam — rises from the dial only while a surplus window is actually
   live (toggled via .steam-active in customer.js). Tied to real meaning,
   not decoration: something is genuinely "hot" right now. */
.steam{
  position:absolute; top:-6px; left:50%; transform:translateX(-50%);
  width:70px; height:34px; color:var(--amber); opacity:0; pointer-events:none;
  transition:opacity .6s ease;
}
.steam.steam-active{ opacity:0.55; }
.steam-wisp{ transform-origin:center bottom; animation:steam-rise 3.4s ease-in-out infinite; }
.steam-wisp-2{ animation-delay:.5s; }
.steam-wisp-3{ animation-delay:1s; }
@keyframes steam-rise{
  0%{ transform:translateY(4px) scaleY(0.9); opacity:0.3; }
  50%{ transform:translateY(-3px) scaleY(1.05); opacity:0.9; }
  100%{ transform:translateY(4px) scaleY(0.9); opacity:0.3; }
}
.dial-svg{ width:100%; height:auto; }
.dial-status{
  margin-top:16px; text-align:center;
  font-family:var(--f-display); font-style:italic; font-size:1.05rem; color:var(--amber);
}
.dial-status span{ display:block; font-family:var(--f-mono); font-style:normal; font-size:0.72rem; color:rgba(246,241,227,0.6); margin-top:4px; letter-spacing:0.04em; }

/* ---------- section headers ---------- */
.section{ padding:54px 0; }
.section-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:28px; flex-wrap:wrap; }
.section-head h2{ font-family:var(--f-display); font-size:1.7rem; font-weight:600; margin:0; }
.section-head p{ margin:6px 0 0; color:rgba(36,31,26,0.6); max-width:52ch; }

/* ---------- search bar ---------- */
.search-bar{ margin-bottom:18px; }
.search-bar input{
  padding:13px 16px; font-size:0.98rem;
  background:#fff;
  max-width:900px;
}
.search-bar input::-webkit-search-cancel-button{ cursor:pointer; }

/* ---------- filter bar ---------- */
.filter-bar{
  display:flex; gap:10px; flex-wrap:wrap; margin-bottom:30px;
}
.filter-chip{
  padding:8px 16px; border-radius:999px; border:1.5px solid var(--line);
  background:transparent; font-size:0.86rem; font-weight:500; color:var(--charcoal);
  transition:all .15s;
}
.filter-chip.active, .filter-chip:hover{ border-color:var(--ink); background:var(--ink); color:var(--paper); }

/* ---------- ticket stub card ---------- */
.listing-grid{
  display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:26px;
}

/* Outer card — holds the optional food photo on top, and the existing
   two-column (main + stub) row below it. The photo is a sibling of
   .ticket, not a child inside its flex row, so it can't squish the
   vendor/price/reserve layout. */
.ticket-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 1px 2px rgba(23,27,51,0.04);
  transition:box-shadow .18s ease, transform .18s ease;
}
.ticket-card:hover{ box-shadow:0 10px 24px rgba(23,27,51,0.10); transform:translateY(-2px); }

/* Photo area — ALWAYS present at a fixed height, whether or not the
   vendor uploaded a photo, so every card in a row lines up the same.
   No dependency on a placeholder image file existing: the fallback is
   pure CSS (a tinted category glyph), so it can never 404 or vanish. */
.ticket-photo{
  position:relative;
  height:170px;
  background:linear-gradient(150deg, #EFE6D0 0%, var(--paper-dim) 100%);
  border-bottom:1px solid var(--line);
  overflow:hidden;
  display:flex; align-items:center; justify-content:center;
}
.ticket-image{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
}
.ticket-photo-fallback{
  font-size:2.6rem; opacity:0.5; filter:grayscale(0.15);
}
.ticket-photo:has(.ticket-image) .ticket-photo-fallback{ display:none; }

.discount-tag{
  position:absolute; top:10px; right:10px;
  background:var(--rust); color:#fff; font-family:var(--f-mono); font-weight:600;
  font-size:0.72rem; padding:4px 10px; border-radius:999px; white-space:nowrap;
  box-shadow:0 2px 6px rgba(0,0,0,0.18);
}

.ticket{
  display:flex;
}
.ticket-main{ flex:1; padding:20px 20px 18px; min-width:0; }
.ticket-top{ margin-bottom:10px; }
.ticket-vendor{
  display:flex; align-items:center; gap:6px; min-width:0;
  font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--teal-deep);
}
.ticket-vendor-logo{ width:16px; height:16px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.ticket-vendor-name{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ticket-vendor-address{
  display:block; margin-top:2px;
  font-family:var(--f-body); font-size:0.72rem; text-transform:none; letter-spacing:normal;
  color:var(--charcoal); opacity:0.65;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  text-decoration:none;
}
.ticket-vendor-address:hover{
  opacity:0.9; text-decoration:underline;
}
.verified-check{
  flex-shrink:0; width:14px; height:14px; border-radius:50%;
  background:var(--teal); color:#fff; font-size:0.6rem; font-family:var(--f-body);
  display:inline-flex; align-items:center; justify-content:center; line-height:1;
}
.ticket-item{ font-family:var(--f-display); font-weight:600; font-size:1.22rem; line-height:1.2; margin:0 0 6px; }
.ticket-desc{ font-size:0.86rem; color:rgba(36,31,26,0.62); line-height:1.45; margin:0 0 14px; }
.ticket-prices{ display:flex; align-items:baseline; gap:9px; margin-bottom:12px; }
.price-old{ text-decoration:line-through; color:rgba(36,31,26,0.4); font-size:0.92rem; }
.price-new{ font-family:var(--f-mono); font-weight:600; font-size:1.15rem; color:var(--ink); }
.ticket-meta{ display:flex; flex-wrap:wrap; gap:14px; font-size:0.78rem; color:rgba(36,31,26,0.58); }
.ticket-meta strong{ color:var(--charcoal); font-weight:600; }

.ticket-stub{
  width:128px; flex-shrink:0;
  background:var(--paper);
  border-left:2px dashed rgba(36,31,26,0.28);
  position:relative;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:16px 12px;
  text-align:center;
}
.ticket-stub::before, .ticket-stub::after{
  content:''; position:absolute; left:-9px; width:18px; height:18px; border-radius:50%;
  background:var(--paper); border:1px solid var(--line);
}
.ticket-stub::before{ top:-9px; }
.ticket-stub::after{ bottom:-9px; }
.ticket-stub .stub-label{ font-family:var(--f-mono); font-size:0.62rem; letter-spacing:0.1em; text-transform:uppercase; color:rgba(36,31,26,0.5); margin-bottom:10px; }
.ticket-stub .stub-qty {
  font-family: var(--f-body);
  font-size: 0.72rem;
  font-weight: 500;
  color: rgba(36,31,26,0.55);
  line-height: 1.2;
  margin-top: 10px;
}

.ticket-stub .stub-qty small {
  display: block;
  font-family: var(--f-body);
  font-size: 0.62rem;
  font-weight: 400;
  color: rgba(36,31,26,0.38);
  margin-top: 2px;
}
.ticket-stub .btn{
  width:100%;
  padding:12px 8px;
  font-size:0.85rem;
  font-weight:600;
}

.ticket.sold-out .ticket-main,
.ticket.expired .ticket-main{
  opacity:0.5;
}

.ticket.sold-out .ticket-stub .btn,
.ticket.expired .ticket-stub .btn{
  background:rgba(36,31,26,0.15);
  color:rgba(36,31,26,0.5);
}

.ticket.sold-out .ticket-stub .stub-qty,
.ticket.expired .ticket-stub .stub-qty{
  opacity:0.45;
}

/* ---------- empty state ---------- */
.empty-state{
  text-align:center; padding:60px 20px; border:1.5px dashed var(--line); border-radius:12px;
  color:rgba(36,31,26,0.55);
}
.empty-state h3{ font-family:var(--f-display); font-size:1.2rem; color:var(--charcoal); margin:0 0 8px; }

/* ---------- how it works ---------- */
.how-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:24px; }
.how-card{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:22px; }
.how-card .how-mark{ font-family:var(--f-mono); font-size:0.72rem; color:var(--teal-deep); letter-spacing:0.08em; margin-bottom:10px; }
.how-card h3{ font-family:var(--f-display); font-size:1.1rem; margin:0 0 8px; }
.how-card p{ font-size:0.9rem; color:rgba(36,31,26,0.62); line-height:1.55; margin:0; }

/* ---------- your pickups ---------- */
.pickups-panel{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:24px; }
.pickup-lookup{ display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; }
.pickup-lookup input{ flex:1; min-width:180px; }
.pickup-row{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding:14px 0; border-top:1px solid var(--line);
}
.pickup-row:first-of-type{ border-top:none; }
.pickup-row-info strong{ display:block; font-family:var(--f-display); font-size:1rem; }
.pickup-row-info span{ font-size:0.8rem; color:rgba(36,31,26,0.55); }
.pickup-code-tag{
  font-family:var(--f-mono); font-weight:600; background:var(--paper-dim); border:1px dashed var(--line);
  padding:6px 12px; border-radius:6px; letter-spacing:0.08em;
}
.status-pill{ font-size:0.7rem; font-weight:600; padding:4px 10px; border-radius:999px; text-transform:uppercase; letter-spacing:0.04em; }
.status-reserved{ background:rgba(232,163,61,0.18); color:var(--amber-deep); }
.status-collected{ background:rgba(47,110,103,0.15); color:var(--teal-deep); }
.status-cancelled{ background:rgba(193,84,60,0.14); color:var(--rust); }

/* ---------- forms ---------- */
.field{ margin-bottom:18px; }
.field label{ display:block; font-size:0.85rem; font-weight:600; margin-bottom:7px; }
.field .hint{ font-size:0.78rem; color:rgba(36,31,26,0.5); margin-top:5px; }
input, select, textarea{
  width:100%; font-family:inherit; font-size:0.94rem; padding:11px 13px;
  border:1.5px solid var(--line); border-radius:7px; background:#fff; color:var(--charcoal);
}
input:focus, select:focus, textarea:focus{
  outline:none; border-color:var(--teal); box-shadow:0 0 0 3px rgba(47,110,103,0.14);
}
:focus-visible{ outline:2px solid var(--teal); outline-offset:2px; }
.field-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
fieldset{ border:none; padding:0; margin:0; }

/* ---------- auth pages ---------- */
.auth-shell{
  min-height:calc(100vh - 72px);
  display:grid; place-items:center;
  background:
    radial-gradient(circle at 18% 20%, rgba(232,163,61,0.06), transparent 40%),
    radial-gradient(circle at 85% 80%, rgba(47,110,103,0.08), transparent 45%),
    var(--paper);
  padding:48px 20px;
}
.auth-card{
  width:100%; max-width:440px; background:#fff; border:1px solid var(--line);
  border-radius:14px; padding:36px 34px;
}
.auth-card .eyebrow{ font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--teal-deep); margin-bottom:10px; }
.auth-card h1{ font-family:var(--f-display); font-size:1.7rem; font-weight:600; margin:0 0 8px; }
.auth-card .sub{ font-size:0.9rem; color:rgba(36,31,26,0.6); margin:0 0 26px; }
.auth-switch{ margin-top:20px; text-align:center; font-size:0.88rem; color:rgba(36,31,26,0.6); }
.auth-switch a{ color:var(--teal-deep); font-weight:600; text-decoration:none; }
.form-msg{
  padding:11px 14px; border-radius:8px; font-size:0.85rem; margin-bottom:18px; display:none;
}
.form-msg.show{ display:block; }
.form-msg.error{ background:rgba(193,84,60,0.1); color:var(--rust); border:1px solid rgba(193,84,60,0.25); }
.form-msg.success{ background:rgba(47,110,103,0.1); color:var(--teal-deep); border:1px solid rgba(47,110,103,0.25); }

/* ---------- vendor dashboard ---------- */
.dash-shell{ display:grid; grid-template-columns:220px 1fr; min-height:calc(100vh - 72px); }
.dash-side{ background:var(--ink); color:var(--paper); padding:28px 18px; }
.dash-side .vendor-name{ font-family:var(--f-display); font-size:1.05rem; margin:0 0 3px; }
.dash-side .vendor-status{ font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.06em; opacity:0.65; margin-bottom:24px; }
.dash-nav{ display:flex; flex-direction:column; gap:4px; }
.dash-nav button{
  text-align:left; background:transparent; border:none; color:rgba(246,241,227,0.72);
  padding:10px 12px; border-radius:8px; font-size:0.9rem; font-weight:500; transition:all .15s;
}
.dash-nav button.active, .dash-nav button:hover{ background:rgba(246,241,227,0.08); color:var(--paper); }
.dash-nav button.active{ color:var(--amber); }
.dash-main{ padding:36px 40px; max-width:920px; }
.dash-view{ display:none; }
.dash-view.active{ display:block; }
.dash-head{ display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:26px; gap:20px; flex-wrap:wrap; }
.dash-head h1{ font-family:var(--f-display); font-size:1.6rem; margin:0 0 6px; }
.dash-head p{ margin:0; color:rgba(36,31,26,0.6); font-size:0.92rem; }

.stat-row{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:32px; }
.stat-card{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:18px; }
.stat-card .num{ font-family:var(--f-display); font-size:1.9rem; font-weight:600; }
.stat-card .lbl{ font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.08em; text-transform:uppercase; color:rgba(36,31,26,0.5); }

table.data-table{ width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
table.data-table th{
  text-align:left; font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.06em; text-transform:uppercase;
  color:rgba(36,31,26,0.5); padding:12px 16px; background:var(--paper-dim); border-bottom:1px solid var(--line);
}
table.data-table td{ padding:13px 16px; border-bottom:1px solid var(--line); font-size:0.88rem; vertical-align:middle; }
table.data-table tr:last-child td{ border-bottom:none; }
.qty-editor{ display:flex; align-items:center; gap:8px; }
.qty-editor button{ width:26px; height:26px; border-radius:6px; border:1px solid var(--line); background:#fff; font-weight:700; }
.qty-editor span{ font-family:var(--f-mono); font-weight:600; min-width:16px; text-align:center; }
.icon-btn{ background:none; border:none; color:var(--rust); font-size:0.82rem; font-weight:600; }

.verify-code-form{ display:flex; gap:10px; margin-bottom:18px; }

.doc-card{
  background:#fff; border:1px solid var(--line); border-radius:10px; padding:18px 20px;
  display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
}
.doc-card .doc-info h3{ font-family:var(--f-display); font-size:1.02rem; margin:0 0 4px; }
.doc-card .doc-info p{ margin:0; font-size:0.82rem; color:rgba(36,31,26,0.55); }
.doc-status-pill{ font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:999px; text-transform:uppercase; letter-spacing:0.04em; white-space:nowrap; }
.doc-status-missing{ background:rgba(193,84,60,0.12); color:var(--rust); }
.doc-status-uploaded{ background:rgba(47,110,103,0.14); color:var(--teal-deep); }
.doc-card .doc-actions{ display:flex; align-items:center; gap:10px; }
.doc-card input[type="file"]{ display:none; }
.verify-code-form input{ flex:1; font-family:var(--f-mono); letter-spacing:0.15em; text-transform:uppercase; }

.badge-pending{ background:rgba(232,163,61,0.16); color:var(--amber-deep); padding:2px 10px; border-radius:999px; font-size:0.72rem; font-weight:600; }

/* ---------- modal ---------- */
.modal-overlay{
  position:fixed; inset:0; background:rgba(14,17,34,0.6); backdrop-filter:blur(2px);
  display:none; align-items:center; justify-content:center; z-index:100; padding:20px;
}
.modal-overlay.show{ display:flex; }
.modal-box{
  background:#fff; border-radius:14px; max-width:440px; width:100%; padding:32px;
  position:relative; text-align:center;
}
.modal-box .close-x{ position:absolute; top:14px; right:16px; background:none; border:none; font-size:1.3rem; color:rgba(36,31,26,0.4); }
.modal-box.confirm .stamp{
  width:70px; height:70px; margin:0 auto 18px; border-radius:50%; background:var(--teal);
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.8rem;
}
.modal-box h2{ font-family:var(--f-display); font-size:1.4rem; margin:0 0 8px; }
.modal-box .code-display{
  font-family:var(--f-mono); font-size:2.1rem; font-weight:600; letter-spacing:0.18em;
  background:var(--paper-dim); border:1.5px dashed var(--line); border-radius:10px;
  padding:18px; margin:18px 0; color:var(--ink);
}
.modal-box .code-note{ font-size:0.85rem; color:rgba(36,31,26,0.6); margin-bottom:22px; line-height:1.5; }
.modal-box.form-modal{ text-align:left; }

.footer{ border-top:1px solid var(--line); padding:32px 0; margin-top:40px; }
.footer .wrap{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
.footer p{ font-size:0.8rem; color:rgba(36,31,26,0.5); margin:0; }
.footer .brand{ font-size:1.1rem; }

@media (max-width: 860px){
  .hero .wrap{ grid-template-columns:1fr; }
  .dash-shell{ grid-template-columns:1fr; }
  .dash-side{ display:flex; align-items:center; justify-content:space-between; padding:16px 20px; flex-wrap:wrap; gap:10px; }
  .dash-nav{ flex-direction:row; flex-wrap:wrap; width:100%; gap:6px; }
  .dash-nav button{ flex:0 0 auto; white-space:nowrap; font-size:0.82rem; padding:8px 10px; }
  .dash-main{ padding:24px 20px; }
  .how-grid{ grid-template-columns:1fr; }
  .stat-row{ grid-template-columns:1fr; }
  .field-row{ grid-template-columns:1fr; }
  .nav-links{ gap:14px; }
}
@media (max-width: 640px){
  table.data-table thead{ display:none; }
  table.data-table, table.data-table tbody, table.data-table tr, table.data-table td{ display:block; width:100%; }
  table.data-table{ border:none; background:transparent; }
  table.data-table tr{
    background:#fff; border:1px solid var(--line); border-radius:10px;
    margin-bottom:12px; padding:6px 14px;
  }
  table.data-table td{
    display:flex; justify-content:space-between; align-items:center; gap:12px;
    padding:10px 0; border-bottom:1px solid var(--line); text-align:right;
  }
  table.data-table td:last-child{ border-bottom:none; }
  table.data-table td::before{
    content:attr(data-label); font-family:var(--f-mono); font-size:0.68rem;
    letter-spacing:0.06em; text-transform:uppercase; color:rgba(36,31,26,0.5);
    text-align:left; flex-shrink:0;
  }
  table.data-table td:empty::before{ content:none; }
}
@media (max-width: 560px){
  .ticket{ flex-direction:column; }
  .ticket-stub{ width:auto; border-left:none; border-top:2px dashed rgba(36,31,26,0.28); flex-direction:row; justify-content:space-between; padding:14px 18px; }
  .ticket-stub::before, .ticket-stub::after{ display:none; }
  .ticket-stub .btn{ width:auto; padding:9px 18px; }
  .wrap{ padding:0 18px; }
  .hero{ padding:44px 0 56px; }
