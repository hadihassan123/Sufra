<script>
  function updateNav(isLoggedIn){
    document.getElementById('vendorNavLink').style.display = isLoggedIn ? 'none' : 'inline-block';
    document.getElementById('vendorLoginNavLink').style.display = isLoggedIn ? 'none' : 'inline-block';
    document.getElementById('vendorLogoutNavLink').style.display = isLoggedIn ? 'inline-block' : 'none';
    document.getElementById('vendorDashboardLink').style.display = isLoggedIn ? 'inline-block' : 'none';
    const heroLink = document.getElementById('heroVendorLink');
    if(isLoggedIn){
      heroLink.textContent = 'Go to dashboard';
      heroLink.href = 'vendor-dashboard.html';
    } else {
      heroLink.textContent = 'I run a food business';
      heroLink.href = 'vendor-signup.html';
    }
  }

  function updateAdminNav(){
    const isAdmin = !!sessionStorage.getItem('sufra_admin_passcode');
    document.getElementById('adminLogoutNavLink').style.display = isAdmin ? 'inline-block' : 'none';
  }

  document.getElementById('vendorLogoutNavLink').addEventListener('click', async (e) => {
    e.preventDefault();
    await Store.signOutVendor();
    updateNav(false);
  });

  document.getElementById('adminLogoutNavLink').addEventListener('click', (e) => {
    e.preventDefault();
    sessionStorage.removeItem('sufra_admin_passcode');
    updateAdminNav();
  });

  // Listen for auth state changes and update the nav
  sb.auth.onAuthStateChange((event, session) => {
    updateNav(!!session);
  });

  // Also check on page load
  sb.auth.getSession().then(({ data: { session } }) => {
    updateNav(!!session);
    document.getElementById('mainNav').classList.remove('nav-loading');
  });
  updateAdminNav();
</script>

</body>
</html>
