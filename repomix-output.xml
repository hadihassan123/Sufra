            <p class="hint">Online payment via SkipCash is coming soon — all listings are cash-at-pickup for now.</p>
          </div>
          <button type="submit" id="postListingBtn" class="btn btn-amber btn-block">Post listing</button>
        </form>
      </div>
    </section>

    <section class="dash-view" id="view-payment">
      <div class="dash-head">
        <div><h1>Payment settings</h1><p>Choose how customers pay for your listings. Cash at pickup always works with no setup — card payment is optional and uses your own SkipCash account, never Sufra's.</p></div>
      </div>
      <div style="max-width:560px;">
        <div class="form-msg" id="paymentMsg"></div>

        <div class="doc-card" style="margin-bottom:20px;">
          <div class="doc-info">
            <h3>Cash at pickup</h3>
            <p>Always available — no setup needed.</p>
          </div>
          <span class="doc-status-pill doc-status-uploaded">Active</span>
        </div>

        <div class="doc-card" style="margin-bottom:20px;" id="cardStatusCard">
          <div class="doc-info">
            <h3>Card payment via SkipCash</h3>
            <p id="cardStatusText">Not connected</p>
          </div>
          <span class="doc-status-pill doc-status-missing" id="cardStatusPill">Off</span>
        </div>

        <form id="skipcashForm">
          <div class="field">
            <label for="skipcashClientId">SkipCash Client ID</label>
            <input type="text" id="skipcashClientId" placeholder="From your SkipCash merchant portal">
          </div>
          <div class="field">
            <label for="skipcashKeyId">SkipCash Key ID</label>
            <input type="text" id="skipcashKeyId" placeholder="From your SkipCash merchant portal">
          </div>
          <div class="field">
            <label for="skipcashKeySecret">SkipCash Key Secret</label>
            <input type="password" id="skipcashKeySecret" placeholder="Kept write-only — you won't be able to view this again">
          </div>
          <div class="field">
            <label for="skipcashWebhookSecret">SkipCash Webhook Secret</label>
            <input type="password" id="skipcashWebhookSecret" placeholder="From your SkipCash Sandbox/Production credentials page">
          </div>
          <button type="submit" class="btn btn-teal btn-block">Save and enable card payment</button>
          <p class="hint" style="margin-top:12px;">These are stored so only Sufra's server-side payment function can read them — never visible in your dashboard again, and never sent to the browser.</p>
        </form>

        <button class="btn btn-ghost btn-block" id="disableCardBtn" style="margin-top:14px;">Turn off card payment</button>
      </div>
    </section>

    <section class="dash-view" id="view-documents">
      <div class="dash-head">
        <div><h1>Verification documents</h1><p>Upload these so an admin can confirm your business before your listings go live. PDF, JPG, or PNG, up to 10MB each.</p></div>
      </div>
      <div style="max-width:560px; display:flex; flex-direction:column; gap:16px;" id="documentsList"></div>
    </section>

    <section class="dash-view" id="view-pickup">
      <div class="dash-head">
        <div><h1>Verify pickup</h1><p>Enter the customer's 6-character code to confirm and mark as collected.</p></div>
      </div>
      <div style="max-width:480px;">
        <div class="verify-code-form">
          <input
            type="text"
            id="verifyCodeInput"
            maxlength="6"
            placeholder="e.g. 7HXQ2M"
          >

          <button
            type="button"
            class="btn btn-ghost"
            id="scanQrBtn">
            📷 Scan QR
          </button>

          <button
            class="btn btn-ink"
            id="verifyBtn">
            Check Code
          </button>
        </div>
        <div id="verifyResult"></div>
      </div>
    </section>

    <section class="dash-view" id="view-reservations">
      <div class="dash-head">
        <div><h1>Reservations</h1><p>All reservations across your listings.</p></div>
      </div>
      <table class="data-table">
        <thead><tr><th>Code</th><th>Item</th><th>Customer</th><th>Window</th><th>Status</th></tr></thead>
        <tbody id="reservationsTableBody"></tbody>
      </table>
    </section>

    <div class="modal-overlay" id="qrScannerOverlay">
      <div class="modal-box">
        <button class="close-x" id="closeQrScanner">
          &times;
        </button>
        <h2>Scan Pickup QR</h2>
        <div id="qr-reader"></div>
      </div>
    </div>

  </main>
</div>

