<file path="css/style.css">
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root{
  /* color */
  --ink:        #171B33;
  --ink-deep:   #0E1122;
  --amber:      #E8A33D;
  --amber-deep: #C97F1E;
  --teal:       #2F6E67;
  --teal-deep:  #204C47;
  --paper:      #F6F1E3;
  --paper-dim:  #EBE2C9;
  --charcoal:   #241F1A;
  --rust:       #C1543C;
  --line:       rgba(36,31,26,0.16);
  --line-light: rgba(246,241,227,0.22);

  /* type */
  --f-display: 'Fraunces', serif;
  --f-body:    'Inter', sans-serif;
  --f-mono:    'IBM Plex Mono', monospace;

  --radius: 3px;
}

*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
body{
  margin:0;
  font-family:var(--f-body);
  color:var(--charcoal);
  background:var(--paper);
  -webkit-font-smoothing:antialiased;
}
img{ max-width:100%; display:block; }
a{ color:inherit; }
button{ font-family:inherit; cursor:pointer; }

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
}

@keyframes pulse{
  0%, 100%{ opacity:1; }
  50%{ opacity:0.35; }
}

/* ---------- layout shell ---------- */
.wrap{ max-width:1120px; margin:0 auto; padding:0 28px; }

.site-header{
  position:sticky; top:0; z-index:40;
  background:var(--paper);
  border-bottom:1px solid var(--line);
}
.site-header .wrap{
  display:flex; align-items:center; justify-content:space-between;
  flex-wrap:wrap; gap:8px 16px;
  min-height:72px; padding-top:10px; padding-bottom:10px;
}
.brand{
  display:flex; align-items:baseline; gap:9px;
  font-family:var(--f-display); font-weight:700; font-size:1.5rem;
  letter-spacing:0.01em;
  text-decoration:none; color:var(--ink);
}
.brand small{
  font-family:var(--f-mono); font-weight:400; font-size:0.62rem;
  letter-spacing:0.14em; text-transform:uppercase; color:var(--teal);
}
.nav-links{ display:flex; align-items:center; gap:28px; font-size:0.92rem; font-weight:500; flex-wrap:wrap; }
.nav-links a{ text-decoration:none; color:var(--charcoal); opacity:0.75; transition:opacity .15s; }
.nav-links a:hover{ opacity:1; }
.nav-cta{
  padding:9px 18px; border-radius:999px; background:var(--ink); color:var(--paper) !important;
  opacity:1 !important; font-weight:600;
}
.nav-links.nav-loading{
    visibility: hidden;
}
/* Auth-state nav visibility — driven by a single class on <body> instead
   of four separate JS style.display writes. The initial-load flicker
   itself is already handled by .nav-loading above (hides the whole nav
   until the session check resolves); this just makes the ongoing
   logged-in/logged-out toggling a single class swap instead of four
   individual element writes. */
.auth-only, .guest-only{ display:none; }
body.logged-in .auth-only{ display:inline-block; }
body:not(.logged-in) .guest-only{ display:inline-block; }
.nav-cta:hover{ background:var(--ink-deep); }

/* ---------- buttons ---------- */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  border:none; border-radius:999px; font-weight:600; font-size:0.92rem;
  padding:12px 22px; transition:transform .12s ease, background .15s ease, box-shadow .15s ease;
}
.btn:active{ transform:scale(0.97); }
.btn-amber{ background:var(--amber); color:var(--ink-deep); }
.btn-amber:hover{ background:var(--amber-deep); }

.btn-blue {
  background: #2563eb;
  color: #ffffff;
  border: 1px solid #2563eb;
}
.btn-blue:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;
}
.btn-ink{ background:var(--ink); color:var(--paper); }
.btn-ink:hover{ background:var(--ink-deep); }
.btn-teal{ background:var(--teal); color:var(--paper); }
.btn-teal:hover{ background:var(--teal-deep); }
.btn-ghost{ background:transparent; color:var(--ink); border:1.5px solid var(--line); }
.btn-ghost:hover{ border-color:var(--ink); }
.btn-block{ width:100%; }
.btn[disabled]{ opacity:0.45; cursor:not-allowed; }
.btn-sm{ padding:8px 14px; font-size:0.8rem; }

/* ---------- hero w/ time dial ---------- */
.hero{
  background:radial-gradient(120% 140% at 15% -10%, #232A52 0%, var(--ink) 45%, var(--ink-deep) 100%);
  color:var(--paper);
  padding:64px 0 76px;
  position:relative;
  overflow:hidden;
}
.hero .wrap{ display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:center; }
.hero-eyebrow{
  font-family:var(--f-mono); font-size:0.7rem; letter-spacing:0.16em; text-transform:uppercase;
  color:var(--amber); margin:0 0 18px;
}
.hero h1{
  font-family:var(--f-display); font-weight:600; font-size:clamp(2.3rem, 4vw, 3.4rem);
  line-height:1.05; margin:0 0 20px; letter-spacing:-0.01em;
}
.hero h1 em{ font-style:italic; color:var(--amber); font-weight:500; }
.hero p.lede{
  font-size:1.08rem; line-height:1.6; color:rgba(246,241,227,0.78); max-width:46ch; margin:0 0 30px;
}
.hero-actions{ display:flex; gap:14px; flex-wrap:wrap; }

/* Faint food/drink line-icon scatter — grounds the abstract dial in
   "this is a food site" visually, not just through color and copy. */
.hero-motif{ position:absolute; inset:0; pointer-events:none; color:rgba(246,241,227,0.09); }
.motif-icon{ position:absolute; width:64px; height:64px; }
.motif-cup{ top:10%; right:8%; width:56px; transform:rotate(-6deg); }
.motif-bread{ bottom:8%; right:28%; width:80px; transform:rotate(4deg); }
.motif-plate{ top:58%; right:2%; width:70px; transform:rotate(-3deg); }
.motif-pot{ top:6%; left:42%; width:50px; transform:rotate(8deg); }
@media (max-width: 860px){ .motif-plate, .motif-pot{ display:none; } }

.dial-card{
  background:rgba(246,241,227,0.05);
  border:1px solid var(--line-light);
  border-radius:16px;
  padding:26px;
  backdrop-filter:blur(6px);
  position:relative;
}
.dial-card .dial-label{
  font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase;
  color:rgba(246,241,227,0.55); display:flex; justify-content:space-between; margin-bottom:14px;
}

/* Steam — rises from the dial only while a surplus window is actually
   live (toggled via .steam-active in customer.js). Tied to real meaning,
   not decoration: something is genuinely "hot" right now. */
.steam{
  position:absolute; top:-6px; left:50%; transform:translateX(-50%);
  width:70px; height:34px; color:var(--amber); opacity:0; pointer-events:none;
  transition:opacity .6s ease;
}
.steam.steam-active{ opacity:0.55; }
.steam-wisp{ transform-origin:center bottom; animation:steam-rise 3.4s ease-in-out infinite; }
.steam-wisp-2{ animation-delay:.5s; }
.steam-wisp-3{ animation-delay:1s; }
@keyframes steam-rise{
  0%{ transform:translateY(4px) scaleY(0.9); opacity:0.3; }
  50%{ transform:translateY(-3px) scaleY(1.05); opacity:0.9; }
  100%{ transform:translateY(4px) scaleY(0.9); opacity:0.3; }
}
.dial-svg{ width:100%; height:auto; }
.dial-status{
  margin-top:16px; text-align:center;
  font-family:var(--f-display); font-style:italic; font-size:1.05rem; color:var(--amber);
}
.dial-status span{ display:block; font-family:var(--f-mono); font-style:normal; font-size:0.72rem; color:rgba(246,241,227,0.6); margin-top:4px; letter-spacing:0.04em; }

/* ---------- section headers ---------- */
.section{ padding:54px 0; }
.section-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:28px; flex-wrap:wrap; }
.section-head h2{ font-family:var(--f-display); font-size:1.7rem; font-weight:600; margin:0; }
.section-head p{ margin:6px 0 0; color:rgba(36,31,26,0.6); max-width:52ch; }

/* ---------- search bar ---------- */
.search-bar{ margin-bottom:18px; }
.search-bar input{
  padding:13px 16px; font-size:0.98rem;
  background:#fff;
  max-width:900px;
}
.search-bar input::-webkit-search-cancel-button{ cursor:pointer; }

/* ---------- filter bar ---------- */
.filter-bar{
  display:flex; gap:10px; flex-wrap:wrap; margin-bottom:30px;
}
.filter-chip{
  padding:8px 16px; border-radius:999px; border:1.5px solid var(--line);
  background:transparent; font-size:0.86rem; font-weight:500; color:var(--charcoal);
  transition:all .15s;
}
.filter-chip.active, .filter-chip:hover{ border-color:var(--ink); background:var(--ink); color:var(--paper); }

/* ---------- ticket stub card ---------- */
.listing-grid{
  display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:26px;
}

/* Outer card — holds the optional food photo on top, and the existing
   two-column (main + stub) row below it. The photo is a sibling of
   .ticket, not a child inside its flex row, so it can't squish the
   vendor/price/reserve layout. */
.ticket-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:10px;
  overflow:hidden;
  box-shadow:0 1px 2px rgba(23,27,51,0.04);
  transition:box-shadow .18s ease, transform .18s ease;
}
.ticket-card:hover{ box-shadow:0 10px 24px rgba(23,27,51,0.10); transform:translateY(-2px); }

/* Photo area — ALWAYS present at a fixed height, whether or not the
   vendor uploaded a photo, so every card in a row lines up the same.
   No dependency on a placeholder image file existing: the fallback is
   pure CSS (a tinted category glyph), so it can never 404 or vanish. */
.ticket-photo{
  position:relative;
  height:170px;
  background:linear-gradient(150deg, #EFE6D0 0%, var(--paper-dim) 100%);
  border-bottom:1px solid var(--line);
  overflow:hidden;
  display:flex; align-items:center; justify-content:center;
}
.ticket-image{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
}
.ticket-photo-fallback{
  font-size:2.6rem; opacity:0.5; filter:grayscale(0.15);
}
.ticket-photo:has(.ticket-image) .ticket-photo-fallback{ display:none; }

.discount-tag{
  position:absolute; top:10px; right:10px;
  background:var(--rust); color:#fff; font-family:var(--f-mono); font-weight:600;
  font-size:0.72rem; padding:4px 10px; border-radius:999px; white-space:nowrap;
  box-shadow:0 2px 6px rgba(0,0,0,0.18);
}

.ticket{
  display:flex;
}
.ticket-main{ flex:1; padding:20px 20px 18px; min-width:0; }
.ticket-top{ margin-bottom:10px; }
.ticket-vendor{
  display:flex; align-items:center; gap:6px; min-width:0;
  font-family:var(--f-mono); font-size:0.68rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--teal-deep);
}
.ticket-vendor-logo{ width:16px; height:16px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.ticket-vendor-name{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ticket-vendor-address{
  display:block; margin-top:2px;
  font-family:var(--f-body); font-size:0.72rem; text-transform:none; letter-spacing:normal;
  color:var(--charcoal); opacity:0.65;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  text-decoration:none;
}
.ticket-vendor-address:hover{
  opacity:0.9; text-decoration:underline;
}
.verified-check{
  flex-shrink:0; width:14px; height:14px; border-radius:50%;
  background:var(--teal); color:#fff; font-size:0.6rem; font-family:var(--f-body);
  display:inline-flex; align-items:center; justify-content:center; line-height:1;
}
.ticket-item{ font-family:var(--f-display); font-weight:600; font-size:1.22rem; line-height:1.2; margin:0 0 6px; }
.ticket-desc{ font-size:0.86rem; color:rgba(36,31,26,0.62); line-height:1.45; margin:0 0 14px; }
.ticket-prices{ display:flex; align-items:baseline; gap:9px; margin-bottom:12px; }
.price-old{ text-decoration:line-through; color:rgba(36,31,26,0.4); font-size:0.92rem; }
.price-new{ font-family:var(--f-mono); font-weight:600; font-size:1.15rem; color:var(--ink); }
.ticket-meta{ display:flex; flex-wrap:wrap; gap:14px; font-size:0.78rem; color:rgba(36,31,26,0.58); }
.ticket-meta strong{ color:var(--charcoal); font-weight:600; }

.ticket-stub{
  width:128px; flex-shrink:0;
  background:var(--paper);
  border-left:2px dashed rgba(36,31,26,0.28);
  position:relative;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:16px 12px;
  text-align:center;
}
.ticket-stub::before, .ticket-stub::after{
  content:''; position:absolute; left:-9px; width:18px; height:18px; border-radius:50%;
  background:var(--paper); border:1px solid var(--line);
}
.ticket-stub::before{ top:-9px; }
.ticket-stub::after{ bottom:-9px; }
.ticket-stub .stub-label{ font-family:var(--f-mono); font-size:0.62rem; letter-spacing:0.1em; text-transform:uppercase; color:rgba(36,31,26,0.5); margin-bottom:10px; }
.ticket-stub .stub-qty {
  font-family: var(--f-body);
  font-size: 0.72rem;
  font-weight: 500;
  color: rgba(36,31,26,0.55);
  line-height: 1.2;
  margin-top: 10px;
}

.ticket-stub .stub-qty small {
  display: block;
  font-family: var(--f-body);
  font-size: 0.62rem;
  font-weight: 400;
  color: rgba(36,31,26,0.38);
  margin-top: 2px;
}
.ticket-stub .btn{
  width:100%;
  padding:12px 8px;
  font-size:0.85rem;
  font-weight:600;
}

.ticket.sold-out .ticket-main,
.ticket.expired .ticket-main{
  opacity:0.5;
}

.ticket.sold-out .ticket-stub .btn,
.ticket.expired .ticket-stub .btn{
  background:rgba(36,31,26,0.15);
  color:rgba(36,31,26,0.5);
}

.ticket.sold-out .ticket-stub .stub-qty,
.ticket.expired .ticket-stub .stub-qty{
  opacity:0.45;
}

/* ---------- empty state ---------- */
.empty-state{
  text-align:center; padding:60px 20px; border:1.5px dashed var(--line); border-radius:12px;
  color:rgba(36,31,26,0.55);
}
.empty-state h3{ font-family:var(--f-display); font-size:1.2rem; color:var(--charcoal); margin:0 0 8px; }

/* ---------- how it works ---------- */
.how-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:24px; }
.how-card{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:22px; }
.how-card .how-mark{ font-family:var(--f-mono); font-size:0.72rem; color:var(--teal-deep); letter-spacing:0.08em; margin-bottom:10px; }
.how-card h3{ font-family:var(--f-display); font-size:1.1rem; margin:0 0 8px; }
.how-card p{ font-size:0.9rem; color:rgba(36,31,26,0.62); line-height:1.55; margin:0; }

/* ---------- your pickups ---------- */
.pickups-panel{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:24px; }
.pickup-lookup{ display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; }
.pickup-lookup input{ flex:1; min-width:180px; }
.pickup-row{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding:14px 0; border-top:1px solid var(--line);
}
.pickup-row:first-of-type{ border-top:none; }
.pickup-row-info strong{ display:block; font-family:var(--f-display); font-size:1rem; }
.pickup-row-info span{ font-size:0.8rem; color:rgba(36,31,26,0.55); }
.pickup-code-tag{
  font-family:var(--f-mono); font-weight:600; background:var(--paper-dim); border:1px dashed var(--line);
  padding:6px 12px; border-radius:6px; letter-spacing:0.08em;
}
.status-pill{ font-size:0.7rem; font-weight:600; padding:4px 10px; border-radius:999px; text-transform:uppercase; letter-spacing:0.04em; }
.status-reserved{ background:rgba(232,163,61,0.18); color:var(--amber-deep); }
