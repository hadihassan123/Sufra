    <p class="sub" id="gateSub">Checking your session…</p>
    <div class="form-msg error" id="gateMsg"></div>

    <!-- Shown only once we've confirmed this is an already-logged-in admin account -->
    <form id="passcodeForm" style="display:none;">
      <div class="field">
        <label for="passcode">Admin Passcode</label>
        <input type="password" id="passcode" required placeholder="Enter your admin passcode" autofocus>
      </div>
      <button type="submit" class="btn btn-ink btn-block">Unlock admin panel</button>
    </form>

    <!-- Shown when not logged in at all, or logged in without admin access -->
    <div id="notAdminNotice" style="display:none;">
      <a href="vendor-login.html" class="btn btn-ink btn-block">Log in via vendor dashboard</a>
    </div>
  </div>
</div>

<!-- admin dashboard -->
<main class="wrap" id="adminMain" style="display:none; padding-top:36px; padding-bottom:60px;">
  <div class="dash-head">
    <div><h1 style="font-family:var(--f-display); font-size:1.6rem;">Vendor approvals</h1>
    <p style="color:rgba(36,31,26,0.6);">Approve vendors after manually checking their Commercial Registration, MOPH food license, and Municipality trade license.</p></div>
  </div>
